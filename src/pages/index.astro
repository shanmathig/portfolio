---
import { site } from '../config/site.mjs';
import { caseStudies } from '../data/caseStudies.mjs';
import Layout from '../layouts/Layout.astro';
---

<Layout
	isHome
	title="Shanmathi Gunasekaran — Software Engineer"
	description="I’m Shanmathi, a Georgia Tech computer science B.S./M.S. student interested in backend systems, distributed systems, and reliable ML infrastructure."
>
	<main id="main-content">
		<section class="hero page-width" id="top" aria-labelledby="hero-title">
			<div class="hero-main">
				<div class="hero-copy">
					<h1 id="hero-title"><span>Shanmathi Gunasekaran</span></h1>
					<p class="hero-description">
						I’m a software engineer interested in backend systems, distributed systems, and reliable ML infrastructure.
					</p>
					<div class="hero-actions">
						<a class="button button-dark" href="#work">Selected <em>work</em> <span aria-hidden="true">↓</span></a>
						<a class="text-link" href={site.links.github} target="_blank" rel="noreferrer">
							GitHub <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
			</div>
		</section>

		<section class="work-section" id="work" aria-labelledby="work-title">
			<div class="section-heading page-width">
				<div>
					<p class="eyebrow">Internship projects</p>
					<h2 id="work-title">Selected work</h2>
				</div>
				<p class="section-intro">
					Three projects in data tooling, cloud infrastructure, and applied AI.
				</p>
			</div>
			<div class="project-list page-width">
				{caseStudies.map((study, index) => (
					<article class="project-row">
						<div class="project-copy">
							<p class="project-label">
								<span>0{index + 1}</span> / {study.company} <span class="project-category">{study.category}</span>
							</p>
							<h3>{study.title}</h3>
							<p class="project-summary">{study.summary}</p>
							<a class="case-link" href={`/work/${study.slug}/`}>
								Read the case study <span aria-hidden="true">↗</span>
							</a>
						</div>
					</article>
				))}
			</div>
		</section>

		<section class="experience-section page-width" aria-labelledby="experience-title">
			<div class="experience-heading">
				<p class="eyebrow">Where I’ve contributed</p>
				<h2 id="experience-title">Work experience</h2>
			</div>
			<div class="experience-list">
				<article class="experience-row">
					<div class="experience-company">Uber</div>
					<div><h3>Software Engineering Intern</h3><p>Earner Intelligence Platform</p></div>
					<time datetime="2026-05">May–Aug 2026</time>
				</article>
				<article class="experience-row">
					<div class="experience-company">AWS</div>
					<div><h3>AI/ML Software Development Intern</h3><p>Amazon Bedrock Guardrails</p></div>
					<time datetime="2025-05">May–Aug 2025</time>
				</article>
				<article class="experience-row">
					<div class="experience-company">Equifax</div>
					<div>
						<h3>AI/ML Software Engineering Intern</h3>
						<p>Java cloud-storage dashboard · CNN deepfake detection on Google Cloud</p>
					</div>
					<time datetime="2024-05">May–Aug 2024</time>
				</article>
			</div>
		</section>

		<section class="education-section" id="education" aria-labelledby="education-title">
			<div class="education-inner page-width">
				<div>
					<p class="eyebrow">Education</p>
					<h2 id="education-title">Georgia Tech</h2>
				</div>
				<div class="education-details">
					<p>B.S./M.S. in Computer Science · Specialization in Artificial Intelligence</p>
					<span>Expected May 2027</span>
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
	.page-width {
		width: min(1120px, calc(100% - 96px));
		margin-inline: auto;
	}

	.hero {
		position: relative;
		display: flex;
		min-height: calc(100svh - 82px);
		flex-direction: column;
		overflow: clip;
		justify-content: center;
		padding-block: 64px;
		isolation: isolate;
	}

	.hero::before {
		position: absolute;
		z-index: -1;
		inset: 0;
		background:
			radial-gradient(ellipse at 38% 30%, rgb(227 219 205 / 20%), transparent 58%),
			repeating-linear-gradient(0deg, transparent 0, rgb(77 64 58 / 1.4%) 1px, transparent 2px, transparent 5px);
		content: '';
		pointer-events: none;
	}

	.hero::after {
		position: absolute;
		z-index: -1;
		top: 12%;
		right: -3%;
		width: clamp(210px, 26vw, 370px);
		aspect-ratio: 1;
		border: 1px solid rgb(84 37 41 / 14%);
		border-radius: 50%;
		box-shadow:
			inset 0 0 0 22px var(--pearl),
			inset 0 0 0 23px rgb(84 37 41 / 12%),
			inset 0 0 0 76px var(--pearl),
			inset 0 0 0 77px rgb(84 37 41 / 10%);
		content: '';
		opacity: 0.72;
		pointer-events: none;
		animation: orbit-drift 24s ease-in-out infinite alternate;
	}

	.eyebrow,
	.project-label,
	.experience-row time {
		font-size: 0.61rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.hero-main {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
	}

	h1,
	h2 {
		font-family: var(--serif);
		font-weight: 400;
	}

	h1 {
		margin: 0 0 27px;
		font-size: clamp(3rem, 8vw, 7.5rem);
		line-height: 1;
		letter-spacing: -0.085em;
		white-space: nowrap;
		animation: rise-in 850ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
	}

	h1 span {
		color: var(--burgundy);
		font-style: italic;
	}

	.hero-description {
		max-width: 575px;
		margin: 0 0 28px;
		color: var(--cacao);
		font-size: 0.91rem;
		line-height: 1.8;
		animation: rise-in 850ms 120ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
	}

	.hero-actions {
		display: flex;
		align-items: center;
		gap: 28px;
		animation: rise-in 850ms 220ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
	}

	@keyframes rise-in {
		from {
			opacity: 0;
			transform: translateY(16px);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes orbit-drift {
		from {
			transform: translate3d(0, -8px, 0) rotate(-8deg);
		}

		to {
			transform: translate3d(0, 12px, 0) rotate(8deg);
		}
	}

	.button,
	.text-link {
		display: inline-flex;
		align-items: center;
		gap: 20px;
		font-size: 0.7rem;
		text-decoration: none;
		transition: background 180ms ease, color 180ms ease;
	}

	.button-dark {
		padding: 14px 18px;
		border: 1px solid var(--leather);
		background: var(--leather);
		color: var(--pearl);
	}

	.button-dark:hover {
		border-color: var(--burgundy);
		background: var(--burgundy);
	}

	.text-link {
		padding-block: 12px;
		border-bottom: 1px solid var(--khaki);
		color: var(--leather);
	}

	.text-link span {
		color: var(--burgundy);
	}

	.work-section {
		padding: 97px 0 91px;
		background: var(--leather);
		color: var(--pearl);
	}

	.section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 50px;
		padding-bottom: 39px;
	}

	.eyebrow {
		margin: 0 0 13px;
		color: var(--burgundy);
	}

	.section-heading h2,
	.experience-heading h2 {
		margin: 0;
		font-size: clamp(3.2rem, 6vw, 5.4rem);
		line-height: 0.99;
		letter-spacing: -0.065em;
	}

	.section-heading h2 em {
		color: var(--burgundy);
		font-weight: 400;
	}

	.work-section .eyebrow {
		color: #d7b6ac;
	}

	.work-section .section-heading h2 em {
		color: #d7b6ac;
	}

	.section-heading h2 {
		white-space: nowrap;
	}

	.section-intro {
		width: 330px;
		margin: 0 0 5px;
		color: #d4cdc5;
		font-size: 0.76rem;
		line-height: 1.8;
	}

	.project-row {
		padding: 40px 0;
		border-top: 1px solid #514a46;
	}

	.project-row:last-child {
		border-bottom: 1px solid #514a46;
	}

	.project-label {
		margin: 0 0 17px;
		color: #c5b8af;
		font-size: 0.52rem;
		letter-spacing: 0.09em;
	}

	.project-label > span:first-child {
		color: #d7b6ac;
	}

	.project-category {
		display: inline-block;
		margin-left: 8px;
		color: #bfb6af;
		font-size: 0.47rem;
	}

	.project-copy h3 {
		margin: 0 0 12px;
		font-family: var(--sans);
		font-size: clamp(1.55rem, 2.5vw, 2.05rem);
		font-weight: 500;
		line-height: 1.2;
		letter-spacing: -0.035em;
	}

	.project-summary {
		max-width: 620px;
		margin: 0 0 16px;
		color: #e2dbd4;
		font-size: 0.74rem;
		line-height: 1.8;
	}

	.case-link {
		display: inline-flex;
		gap: 18px;
		padding-bottom: 6px;
		border-bottom: 1px solid #736761;
		color: #e6bfb4;
		font-size: 0.67rem;
		text-decoration: none;
	}

	.case-link:hover {
		border-color: #e6bfb4;
	}

	.experience-section {
		display: grid;
		grid-template-columns: 0.7fr 1.3fr;
		gap: 80px;
		padding-block: 108px;
	}

	.experience-heading h2 {
		max-width: 310px;
		font-size: clamp(2.7rem, 4.5vw, 4rem);
		line-height: 1.04;
	}

	.experience-heading .eyebrow {
		max-width: 220px;
		line-height: 1.7;
	}

	.experience-list {
		border-top: 1px solid var(--khaki);
	}

	.education-section {
		position: relative;
		overflow: hidden;
		padding-block: clamp(65px, 9vw, 112px);
		background: var(--burgundy);
		color: var(--pearl);
	}

	.education-section::after {
		position: absolute;
		top: 50%;
		right: max(-70px, calc((100vw - 1200px) / 2));
		width: clamp(210px, 29vw, 390px);
		aspect-ratio: 1;
		transform: translateY(-50%);
		border: 1px solid rgb(250 248 245 / 16%);
		border-radius: 50%;
		box-shadow:
			inset 0 0 0 24px var(--burgundy),
			inset 0 0 0 25px rgb(250 248 245 / 12%),
			inset 0 0 0 78px var(--burgundy),
			inset 0 0 0 79px rgb(250 248 245 / 10%);
		content: '';
		pointer-events: none;
	}

	.education-inner {
		position: relative;
		z-index: 1;
		display: flex;
		min-height: 175px;
		align-items: end;
		justify-content: space-between;
		gap: 40px;
	}

	.education-section h2 {
		margin: 0;
		font-family: var(--serif);
		font-size: clamp(2.9rem, 5.5vw, 5rem);
		font-weight: 400;
		letter-spacing: -0.06em;
	}

	.education-section .eyebrow {
		margin-bottom: 6px;
		color: #e6bfb4;
	}

	.education-details {
		max-width: 430px;
		text-align: right;
	}

	.education-details p {
		margin: 0 0 5px;
		color: #f0e9e3;
		font-size: 0.8rem;
		line-height: 1.7;
	}

	.education-details span {
		color: #d7b6ac;
		font-size: 0.62rem;
		letter-spacing: 0.06em;
	}

	@keyframes section-reveal {
		from {
			opacity: 0.35;
			transform: translateY(28px);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@supports (animation-timeline: view()) {
		.project-row,
		.experience-row,
		.education-inner {
			animation: section-reveal linear both;
			animation-timeline: view();
			animation-range: entry 0% entry 45%;
		}
	}

	.case-link span {
		display: inline-block;
		transition: transform 220ms ease;
	}

	.case-link:hover span {
		transform: translate(3px, -3px);
	}

	.experience-row {
		display: grid;
		grid-template-columns: 95px minmax(0, 1fr) auto;
		align-items: start;
		gap: 20px;
		padding: 19px 0;
		border-bottom: 1px solid var(--khaki);
	}

	.experience-company {
		color: var(--burgundy);
		font-family: var(--serif);
		font-size: 1.42rem;
	}

	.experience-row h3 {
		margin: 2px 0 5px;
		font-size: 0.72rem;
		font-weight: 500;
	}

	.experience-row p {
		margin: 0;
		color: #81766d;
		font-size: 0.62rem;
	}

	.experience-row time {
		padding-top: 6px;
		color: #81766d;
		font-size: 0.48rem;
		white-space: nowrap;
	}

	@media (max-width: 800px) {
		.page-width {
			width: min(100% - 48px, 650px);
		}

		.hero {
			min-height: calc(100svh - 82px);
			padding-block: 55px;
		}

		.hero::after {
			top: 7%;
			right: -17%;
			width: clamp(210px, 38vw, 310px);
		}
		.experience-section {
			grid-template-columns: 1fr;
			gap: 29px;
			padding-block: 76px;
		}

		.experience-heading h2 {
			max-width: none;
		}

	}

	@media (max-width: 540px) {
		.page-width {
			width: calc(100% - 36px);
		}

		.hero {
			min-height: calc(100svh - 68px);
			padding-block: 48px;
		}

		h1 {
			font-size: clamp(2rem, 9.1vw, 3.3rem);
			letter-spacing: -0.075em;
			white-space: normal;
		}

		.hero::after {
			top: 1%;
			right: -43%;
			width: 230px;
		}

		.hero-description {
			font-size: 0.81rem;
		}

		.work-section {
			padding-block: 70px;
		}

		.section-heading {
			display: block;
			padding-bottom: 29px;
		}

		.section-heading h2 {
			font-size: clamp(2.4rem, 10.5vw, 3.5rem);
			white-space: normal;
		}

		.section-intro {
			width: auto;
			margin-top: 18px;
		}

		.project-label {
			font-size: 0.47rem;
		}

		.project-category {
			display: block;
			margin: 6px 0 0 24px;
		}

		.experience-row {
			grid-template-columns: 57px minmax(0, 1fr);
			gap: 10px;
		}

		.experience-row time {
			grid-column: 2;
			padding-top: 0;
		}

		.experience-company {
			font-size: 1.2rem;
		}

		.education-section {
			padding-block: 57px;
		}

		.education-section::after {
			top: 15%;
			right: -34%;
			width: 220px;
			transform: none;
		}

		.education-inner {
			min-height: 0;
		}

		.education-inner {
			align-items: flex-start;
			flex-direction: column;
			gap: 24px;
		}

		.education-details {
			text-align: left;
		}

		.experience-heading h2 {
			font-size: clamp(2.7rem, 10.5vw, 3.4rem);
		}
	}
</style>
